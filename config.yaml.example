# SSH ↔ MOSH WAN Gateway — example configuration
# Copy to config.yaml and adjust; or use environment variables instead.
#
# Security model
# --------------
# The remote target is FIXED here.  Dynamic routing is disabled — clients
# cannot connect to arbitrary hosts through this gateway.
#
# The SSH login username becomes the remote username.
# Authentication to the remote is passed through via the client's SSH agent.
# Always connect with:  ssh -A user@gateway -p 2222

# ── SSH server (local clients → gateway) ─────────────────────────────────────
host: "0.0.0.0"
port: 2222
host_key_path: "/etc/gateway/host_key"   # auto-generated if missing

# ── Client → Gateway authentication ──────────────────────────────────────────
#
# Option A: no authorized_keys configured  (zero-config, recommended default)
#   The gateway accepts any client public key and delegates auth to the remote:
#   the client's forwarded agent must satisfy the remote server's authorized_keys.
#   No separate key management on the gateway needed.
#
# Option B: local authorized_keys file  (pre-screen before hitting the remote)
# authorized_keys_path: "/keys/authorized_keys"
#
# Option C: inline authorized_keys text
# authorized_keys_content: |
#   ssh-ed25519 AAAA... alice@laptop
#   ssh-ed25519 AAAA... bob@desktop
#
# Option D: password authentication
# password_auth: true
# passwords:
#   alice: "s3cr3t"
#   bob: "p4ssw0rd"
#
# Dev / trusted-LAN only — never enable in production
# accept_any_key: true

# ── Fixed remote MOSH target  (REQUIRED) ─────────────────────────────────────
remote_host: "my-server.example.com"    # required — only host clients can reach
remote_port: 22

# ── Remote host-key verification ─────────────────────────────────────────────
# remote_known_hosts: "/keys/known_hosts"    # recommended: pin the remote host key
# remote_ignore_host_key: false              # true = skip verification (insecure)
