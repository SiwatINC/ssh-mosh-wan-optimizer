# SSH ↔ MOSH WAN Gateway — example configuration
# Copy to config.yaml and adjust; or use environment variables instead.
#
# Security model
# --------------
# The remote target is FIXED here.  Dynamic routing is disabled — clients
# cannot connect to arbitrary hosts through this gateway.
#
# The SSH login username becomes the remote username.
# The gateway authenticates to the remote with its own key (GATEWAY_SSH_KEY_PATH).
# Clients connect with a plain:  ssh user@gateway -p 2222

# ── SSH server (local clients → gateway) ─────────────────────────────────────
host: "0.0.0.0"
port: 2222
host_key_path: "/etc/gateway/host_key"   # auto-generated if missing

# ── Client → Gateway authentication ──────────────────────────────────────────
#
# Default (no config needed): the gateway fetches ~/.ssh/authorized_keys from
# the remote server for each connecting user and validates against those keys.
# The remote's key store is the single source of truth — no separate key
# management on the gateway.
#
# Override with a local authorized_keys file (takes precedence if set):
# authorized_keys_path: "/keys/authorized_keys"
# authorized_keys_content: |
#   ssh-ed25519 AAAA... alice@laptop
#
# Password authentication (optional):
# password_auth: true
# passwords:
#   alice: "s3cr3t"
#
# Dev / trusted-LAN only — never enable in production:
# accept_any_key: true

# ── Fixed remote MOSH target  (REQUIRED) ─────────────────────────────────────
remote_host: "my-server.example.com"    # required — only host clients can reach
remote_port: 22

# ── Gateway → Remote authentication ──────────────────────────────────────────
# Private key the gateway uses to authenticate to the remote server.
# The corresponding public key must be in authorized_keys on the remote.
gateway_ssh_key_path: "/keys/id_ed25519"
# gateway_ssh_key_content: "<base64-encoded-private-key>"  # alternative to file

# ── Remote host-key verification ─────────────────────────────────────────────
# remote_known_hosts: "/keys/known_hosts"    # recommended: pin the remote host key
# remote_ignore_host_key: false              # true = skip verification (insecure)
